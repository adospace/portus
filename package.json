{
  "name": "portus",
  "version": "0.6.0",
  "description": "portus — agentic terminal: mission control for multiple AI agent CLI sessions",
  "license": "MIT",
  "author": "Adolfo Marinucci",
  "homepage": "https://github.com/adospace/portus",
  "repository": {
    "type": "git",
    "url": "https://github.com/adospace/portus.git"
  },
  "bugs": {
    "url": "https://github.com/adospace/portus/issues"
  },
  "main": "dist/electron/main.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "icon": "node scripts/make-icon.mjs",
    "build:bundle": "node scripts/build.mjs",
    "build:css": "tailwindcss -i renderer/styles.css -o dist/renderer/styles.css --minify",
    "build": "npm run build:bundle && npm run build:css",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && node scripts/start.mjs",
    "dev": "npm run build && node scripts/start.mjs",
    "pack": "electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@iconify/types": "^2.0.0",
    "@tailwindcss/cli": "^4.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.24.0",
    "iconify-icon": "^3.0.0",
    "monaco-editor": "^0.55.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
